{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Rebost",
        "width": 1320,
        "height": 860,
        "minWidth": 640,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] },
        "scrollBarStyle": "fluentOverlay"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "compression": "zlib",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}

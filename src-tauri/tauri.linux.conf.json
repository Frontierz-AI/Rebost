{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "resources": ["resources/tessdata/*.traineddata", "resources/tessdata/LICENSE", "resources/engine/*.tar.gz"],
    "longDescription": "Rebost runs an AI on this computer and answers questions about the documents kept here, citing the files it used. Point a Shelf at a folder and ask in Chat. Documents are not uploaded.",
    "icon": ["icons/256x256.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/rebost.desktop",
        "recommends": ["libvulkan1", "mesa-vulkan-drivers", "xdg-utils"]
      },
      "rpm": {
        "desktopTemplate": "linux/rebost.desktop",
        "recommends": ["vulkan-loader", "mesa-vulkan-drivers", "xdg-utils"],
        "postRemoveScript": "linux/rpm-postun.sh"
      }
    }
  }
}

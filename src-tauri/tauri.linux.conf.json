{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["icons/128x128@2x.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/rebost.desktop",
        "recommends": ["libvulkan1", "mesa-vulkan-drivers", "xdg-utils"]
      },
      "rpm": {
        "desktopTemplate": "linux/rebost.desktop",
        "recommends": ["vulkan-loader", "mesa-vulkan-drivers", "xdg-utils"]
      }
    }
  }
}
